# --- Server ---
LISTEN_ADDR=:8080
# Shared secret for webhooks. Send as "Authorization: Bearer <token>",
# "X-Webhook-Token: <token>" or "?token=<token>". Empty = no auth (dev only).
WEBHOOK_TOKEN=change-me
LOG_LEVEL=info
WORKERS=4

# --- AI triage (optional: leave the key empty to forward raw alerts only) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_TOKENS=2048
AI_TIMEOUT=30s
# Re-use a triage for the same alert fingerprint instead of calling the API again.
AI_COOLDOWN=30m

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Forum topic id (message_thread_id). 0 or empty = main chat.
TELEGRAM_THREAD_ID=
TELEGRAM_API_URL=https://api.telegram.org

# --- Slack (optional) ---
SLACK_WEBHOOK_URL=
